# ================================================================
# ClipGrab Bot - Sozlamalar (.env)
# ================================================================

# Telegram Bot Token (@BotFather dan olingan token)
BOT_TOKEN=

# Bot adminlarining Telegram ID raqamlari (vergul bilan ajratilgan, masalan: 123456789,987654321)
ADMIN_IDS=

# Maksimal yuklash hajmi (MB da, Telegram Bot API standarti bo'yicha 50 MB)
MAX_FILE_MB=50

# Maksimal video davomiyligi (soniyalarda, 600 = 10 daqiqa)
MAX_DURATION_SEC=600

# Bir vaqtning o'zida parallel yuklashlar limiti (serverni ortiqcha yuklamaslik uchun)
MAX_CONCURRENT_DOWNLOADS=3

# Bitta yuklash uchun maksimal kutish vaqti (soniyalarda)
DOWNLOAD_TIMEOUT_SEC=120

# Ruxsat berilgan video platformalari
ALLOWED_DOMAINS=youtube.com,youtu.be,tiktok.com,vm.tiktok.com,instagram.com,facebook.com,fb.watch,x.com,twitter.com,pinterest.com

# Instagram yoki yopiq videolar uchun cookies.txt fayl yo'li (ixtiyoriy, masalan: /app/cookies/cookies.txt)
COOKIES_FILE=

# SQLite ma'lumotlar bazasi yo'li (Docker uchun: /app/data/bot.db)
DB_PATH=/app/data/bot.db

# Log darajasi: INFO, DEBUG, WARNING, ERROR
LOG_LEVEL=INFO
